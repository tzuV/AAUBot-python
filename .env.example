# vLLM model to serve (HuggingFace model ID)
# Must match generator.model in config.yaml
VLLM_MODEL=Qwen/Qwen3-8B

# vLLM GPU memory utilization (0.0-1.0)
# Lower this if the embedding model also uses the GPU
VLLM_GPU_MEM_UTIL=0.90

# vLLM max context window in tokens
VLLM_MAX_MODEL_LEN=8192

# HuggingFace token (optional, needed for gated models)
HF_TOKEN=

# Discord bot token (leave empty to disable Discord integration)
DISCORD_TOKEN=
